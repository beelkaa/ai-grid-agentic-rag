# AI Grid hosted inference (chat completions + embeddings)
AI_GRID_API_KEY=your-ai-grid-api-key
AI_GRID_BASE_URL=https://your-ai-grid-api-base-url
DEFAULT_MODEL_LABEL=google/gemma-4-31B

# PostgreSQL (conversation history)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Langfuse tracing (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
